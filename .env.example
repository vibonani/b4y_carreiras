# Senha de acesso à área da gerência/RH. Troque por uma senha forte.
ADMIN_PASSWORD=troque-esta-senha

# Chave secreta usada para assinar o cookie de sessão. Gere uma aleatória, ex:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-esta-chave-secreta

# Porta do servidor (opcional)
PORT=8787

# Backend de armazenamento das sessões de avaliação (opcional).
# "json" (padrão) grava em data/sessions.json, localmente.
# "sheets" usa o Google Apps Script/Google Sheets — exige as duas variáveis abaixo.
DATA_BACKEND=json

# Necessárias apenas quando DATA_BACKEND=sheets.
# URL da implantação do Web App do Google Apps Script (ver apps-script/Code.gs).
APPS_SCRIPT_URL=
# Deve ser IDÊNTICO ao valor de SHARED_SECRET dentro do apps-script/Code.gs.
APPS_SCRIPT_SECRET=
